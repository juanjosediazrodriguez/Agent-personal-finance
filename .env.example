# Copia este archivo como .env y llena los valores. El .env nunca se sube al repo.

# --- LLM (cualquier proveedor compatible con la API de OpenAI) ---
# NVIDIA:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Supabase ---
SUPABASE_URL=
# La anon key es pública por diseño: la protección la da la RLS.
SUPABASE_ANON_KEY=
# Solo para los scripts locales que cargan los datos sintéticos. Nunca en el backend desplegado ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Next.js expone al navegador solo las que empiezan por NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
